  "description": "Aplikasi booking ruang meeting dengan persetujuan bertingkat, monitoring pemakaian, dan riwayat aktivitas",
  "author": "Fedy Fs. Gerana (https://github.com/fedyfsgerana)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fedyfsgerana/meeting-room-booking.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
